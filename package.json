{
  "name": "ariadne-fintech-atlas",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "predev": "npm run data",
    "dev": "vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "build:artifact": "npm run build && node scripts/prepare-artifact.mjs",
    "icons": "node scripts/make-icons.mjs",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run data",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "npm run data && vitest run --project component",
    "test:coverage": "npm run data && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.17.10",
    "@xyflow/react": "12.12.1",
    "d3-geo": "3.1.1",
    "elkjs": "0.12.1",
    "minisearch": "7.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "three-stdlib": "2.36.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.14",
    "@types/node": "26.6.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.1",
    "png-to-ico": "2.1.8",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
